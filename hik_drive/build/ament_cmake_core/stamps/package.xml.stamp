<?xml version="1.0"?>
<package format="3">
  <name>hik_camera_driver</name>
  <version>0.1.0</version>
  <description>Calibration tool using Hikvision camera and OpenCV.</description>

  <maintainer email="your_email@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS2 buildtool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- System dependencies -->
  <depend>opencv</depend>
  <depend>eigen</depend>
  <depend>threads</depend>

  <!-- ROS2 message dependencies (if you later add ROS2 nodes) -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend> 

  <!-- Optional: test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>